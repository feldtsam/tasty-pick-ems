# cfb/ — CFB v1 red-zone ingestion. Copy to cfb/.env.local for local runs
# (that file is gitignored). On Vercel, set these as project env vars.

# CFBD free-tier Bearer token — https://collegefootballdata.com/key
CFBD_API_KEY=

# Shared secret the manual trigger checks (X-Pipeline-Secret header).
# Reuse the NFL/MLB value or pick a new one — must match whatever calls
# POST /api/ingest-and-write-redzone.
PIPELINE_INCOMING_SECRET=

# HMAC secret for the outbound signed POSTs to the two Lovable write
# routes. MUST match CFB_PIPELINE_WEBHOOK_SECRET set on the tastypickems
# (Lovable) side. Distinct from NFL_PIPELINE_WEBHOOK_SECRET.
CFB_PIPELINE_WEBHOOK_SECRET=

# Optional URL overrides — default to
#   https://tastypickems.lovable.app/api/public/cfb-player-redzone-weekly-write
#   https://tastypickems.lovable.app/api/public/cfb-defense-redzone-allowed-weekly-write
LOVABLE_CFB_PLAYER_REDZONE_WEEKLY_WRITE_URL=
LOVABLE_CFB_DEFENSE_REDZONE_ALLOWED_WEEKLY_WRITE_URL=
