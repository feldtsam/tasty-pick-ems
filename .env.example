# ============================================================
# Tasty Pick Ems — Environment Variables
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real API keys below
#   3. Never commit your .env file — it's in .gitignore
# ============================================================

# ── The Odds API ──────────────────────────────────────────────
# Sign up at https://the-odds-api.com
# Free tier: ~500 requests/month. Good for game-level odds.
# NOTE: HR player props require the paid "Pro" plan (~$79/mo).
#       Without a paid plan, the dashboard shows mock HR props.
ODDS_API_KEY=your_odds_api_key_here

# ── Weather API ───────────────────────────────────────────────
# Using Open-Meteo (https://open-meteo.com) — free, no key needed.
# No sign-up required. Just run the server and weather works automatically.

# ── Server config ─────────────────────────────────────────────
# Port the backend runs on (default: 5001)
# Only change this if something else is using 5001 on your machine.
PORT=5001

# ── MLB Stats API ─────────────────────────────────────────────
# No key needed! The MLB Stats API is completely free and public.
# Docs: https://statsapi.mlb.com/docs/
